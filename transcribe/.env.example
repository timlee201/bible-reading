# AssemblyAI speech-to-text and LLM Gateway key. Never commit a real value.
ASSEMBLYAI_API_KEY=

# OAuth web client (Google Cloud → APIs & Services → Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Browser key used by Google Picker. Restrict it to the Picker API and this origin.
GOOGLE_API_KEY=

# Only this Google account can sign in (compared case-insensitively).
ALLOWED_EMAIL=

# Public origin of this app, no trailing slash.
# Local: http://localhost:8080
# Cloud Run: https://SERVICE-URL
APP_ORIGIN=http://localhost:8080

# Signs the session cookie and seals webhook/file tokens (AES-256-GCM key material).
SESSION_SECRET=

# Value AssemblyAI must send in the X-Webhook-Secret header.
WEBHOOK_SECRET=

# Optional. If set, every transcript uses this exact webhook URL (no sealed token in the path).
# A cold instance then needs GOOGLE_REFRESH_TOKEN. Leave empty to use a per-job sealed URL.
# Leave empty for localhost: the server omits the webhook and polling writes the HTML file.
WEBHOOK_URL=

# Optional fallback refresh token when WEBHOOK_URL is set and the instance has no session.
GOOGLE_REFRESH_TOKEN=

# Optional LLM Gateway model. Defaults to claude-sonnet-4-6.
CLEANUP_MODEL=

# Optional. Defaults to 8080.
PORT=8080
